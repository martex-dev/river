<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the GitHub artifact is a zip holding River-Setup-<version>.exe. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="River-Setup-*.exe" product-name="River" max-matches="1">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
