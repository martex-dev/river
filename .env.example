# River environment example. Copy to `.env` for local development.
# Never commit real values. `.env` is git-ignored.

# --- Release signing (CI only) -------------------------------------------------
# Ed25519 private key (PKCS#8 PEM) used by scripts/release/sign-manifest.ts.
# In GitHub Actions this is the repository secret RIVER_RELEASE_SIGNING_KEY.
# Generate one with: node scripts/release/generate-signing-key.ts <output-dir>
RIVER_RELEASE_SIGNING_KEY=

# --- Desktop (development) ----------------------------------------------------
# Force the updater to run in development builds (normally disabled).
RIVER_DEV_UPDATES=false

# --- Server (from 0.0.2) --------------------------------------------------------
# RIVER_SERVER_PORT=8787
# RIVER_DATABASE_URL=sqlite:./data/river.sqlite
