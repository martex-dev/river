<?xml version="1.0" encoding="utf-8"?>
<!--
  River's data never leaves the phone through Android backup or device
  transfer: the database is encrypted with a key that only this phone's
  Keystore can unwrap, so a copy would be useless and would still leak
  metadata. Use River's own encrypted backup instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
